<Ui xmlns="http://www.blizzard.com/wow/ui/">
    <!-- benilla's layer over the stock login screen, as this fork has it: no Quit button, since in
         a browser tab closing the client is the browser's gesture (the host ignores QuitGame
         too), and the realmlist as a readout alone, the address the next login dials, over the
         Cinematics button; this fork offers no realmlist editor. The host keeps
         BENILLA_REALMLIST. -->
    <Script>
        AccountLoginExitButton:Hide();
        AccountLoginExitButton.Show = AccountLoginExitButton.Hide;
    </Script>
    <Frame name="BenillaRealmlistReadout" parent="AccountLoginUI">
        <Size>
            <AbsDimension x="256" y="20"/>
        </Size>
        <Anchors>
            <Anchor point="BOTTOMRIGHT" relativeTo="AccountLoginCinematicsButton" relativePoint="TOPRIGHT">
                <Offset>
                    <AbsDimension x="0" y="-2"/>
                </Offset>
            </Anchor>
        </Anchors>
        <Layers>
            <Layer level="BACKGROUND">
                <FontString name="BenillaRealmlistText" inherits="GlueFontDisableSmall" justifyH="RIGHT">
                    <Anchors>
                        <Anchor point="RIGHT"/>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
        <Scripts>
            <OnUpdate>
                if ( BenillaRealmlistText:GetText() ~= BENILLA_REALMLIST ) then
                    BenillaRealmlistText:SetText(BENILLA_REALMLIST);
                end
            </OnUpdate>
        </Scripts>
    </Frame>
</Ui>
