# Binary blobs compiled into the client with `include_bytes!`.
#
# Without this, a checkout with `core.autocrlf=true` (the Windows default, and what this tree is
# checked out with) rewrites any 0x0A byte that follows a 0x0D into 0x0D 0x0A on the way out — which
# for a texture is silent corruption, and for `liquid::art`'s committed bump map is a test that
# fails on Windows and passes everywhere else. Marking them binary is what makes the bytes in the
# repository the bytes the compiler sees.
*.rgba binary

# Shell scripts are LF in every working copy. Trunk's post-build hook runs `bash` by bare name,
# and on Windows that resolves System32's WSL bash before any PATH entry, which reads a CRLF
# script's `set -euo pipefail` as the option `pipefail` and fails the whole web build.
*.sh text eol=lf

# The bundled third-party addons are vendored as their authors ship them, byte for byte: the
# client reads them as files, and a checkout must not rewrite a line ending in a `.lua` or a `.tga`.
third_party/addons/** -text
